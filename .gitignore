# ---------------------------------------------------------------------------
# Sensitive files / secrets — DO NOT COMMIT
# ---------------------------------------------------------------------------

# Environment / config secrets
.env
.env.*
!.env.example
*.env
lib/src/config/env.dart
lib/src/config/secrets.dart
secrets.dart

